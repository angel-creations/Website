# EmailJS browser integration. Values are embedded into the static build by Vite.
# The EmailJS public key is designed for browser use; never put private API keys here.
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_NOTIFICATION_TEMPLATE_ID=your_internal_notification_template_id
VITE_EMAILJS_CONFIRMATION_TEMPLATE_ID=your_customer_confirmation_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Optional future server-side lead endpoint (not used by the EmailJS integration).
VITE_LEAD_FORM_ENDPOINT=
