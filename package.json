{
  "name": "angel-creations-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/generateStaticFallbacks.mjs && node scripts/verifyStaticOutput.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:smoke": "node scripts/playwright-smoke.mjs",
    "test:static": "node scripts/playwright-smoke.mjs --static",
    "test:prod": "npm run build && npm run test:static && npm run test:fallback && npm run test:degraded",
    "test:fallback": "node scripts/checkBootFallback.mjs",
    "test:degraded": "node scripts/checkDegradedBoot.mjs",
    "test:emailjs": "node scripts/checkEmailjsSubmission.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
